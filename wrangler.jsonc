{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-evolution-cloudflare",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mcp-evolution",
    "database_id": "d25ad771-5b81-4e41-88ed-6f980a32dbf9",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{
    "binding": "OAUTH_KV",
    "id": "3a5b420e14594ee4ae821b720a9bf74a",
    "preview_id": "29bb2b67785b46bfa7c31d84bbbe9344"
  }],
  "vars": {
    "EVOLUTION_BASE_URL": "https://zipt-zopt.neurau.com.br",
    "MCP_PUBLIC_URL": "https://mcp-evolution-cloudflare.luccamordente.workers.dev",
    "ALLOWED_EMAILS": "luccamordente@gmail.com,heitorsalazar@gmail.com",
    "MAX_MEDIA_BYTES": "8388608",
    "ENVIRONMENT": "production"
  }
}
