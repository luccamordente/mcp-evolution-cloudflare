{
  "name": "whatsapp-mcp",
  "version": "0.7.3",
  "description": "Stateless MCP 2026 server for Evolution Go on Cloudflare Workers",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:stdio": "node scripts/dev-stdio.mjs",
    "prototype:connections": "python3 -m http.server 4173 --directory prototype",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "check": "npm run check:gallery && npm run typecheck && npm test",
    "build:gallery": "node scripts/build-gallery.mjs",
    "check:gallery": "node scripts/build-gallery.mjs --check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/jsdom": "30.0.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": false
}
